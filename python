import os
import time
import requests
import xml.etree.ElementTree as ET
from datetime import datetime, timedelta, timezone
from openai import OpenAI

# -------------------------------------------------------------------
# 1. Environment Variable Retrieval
# -------------------------------------------------------------------
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")
META_PAGE_ACCESS_TOKEN = os.getenv("META_PAGE_ACCESS_TOKEN")
FACEBOOK_PAGE_ID = os.getenv("FACEBOOK_PAGE_ID")
INSTAGRAM_ACCOUNT_ID = os.getenv("INSTAGRAM_ACCOUNT_ID")
TIKTOK_ACCESS_TOKEN = os.getenv("TIKTOK_ACCESS_TOKEN")

# Default Shopify/Sellvia RSS Feed URL for Wonderful Gems Point
RSS_FEED_URL = os.getenv("RSS_FEED_URL", "https://wonderfulgemspoint.shop/collections/all.atom")

# Initialize OpenAI Client
client = OpenAI(api_key=OPENAI_API_KEY)


# -------------------------------------------------------------------
# 2. Fetch New Products from RSS Feed (Past 24 Hours)
# -------------------------------------------------------------------
def fetch_recent_products(feed_url):
    print("[INFO] Fetching product feed...")
    try:
        response = requests.get(feed_url, timeout=10)
        response.raise_for_status()
    except Exception as e:
        print(f"[ERROR] Failed to fetch RSS feed: {e}")
        return []

    products = []
    now = datetime.now(timezone.utc)
    cutoff_time = now - timedelta(days=1)

    try:
        root = ET.fromstring(response.content)
        # Handle standard Atom XML feeds (Shopify style)
        namespace = {'atom': 'http://www.w3.org/2005/Atom'}

        for entry in root.findall('atom:entry', namespace):
            published_str = entry.find('atom:published', namespace).text
            published_dt = datetime.fromisoformat(published_str.replace('Z', '+00:00'))

            if published_dt >= cutoff_time:
                title = entry.find('atom:title', namespace).text
                link = entry.find('atom:link', namespace).attrib.get('href')
                
                # Retrieve product image from media/summary tags
                summary = entry.find('atom:summary', namespace)
                image_url = None
                if summary is not None and 'src="' in summary.text:
                    image_url = summary.text.split('src="')[1].split('"')[0]

                products.append({
                    'title': title,
                    'link': link,
                    'image_url': image_url,
                    'published': published_dt
                })

    except Exception as e:
        print(f"[ERROR] Error parsing XML feed: {e}")

    print(f"[INFO] Found {len(products)} products published in the last 24h.")
    return products


# -------------------------------------------------------------------
# 3. Generate Social Copy via OpenAI
# -------------------------------------------------------------------
def generate_post_copy(product_title, product_link):
    print(f"[INFO] Generating AI post copy for: {product_title}")
    prompt = (
        f"Write an engaging, highly converting social media caption for a product named '{product_title}'. "
        f"Brand: Wonderful Gems Point. Include 3-5 relevant hashtags and a call-to-action to shop at {product_link}. "
        "Keep it concise, friendly, and suitable for Facebook, Instagram, and TikTok."
    )

    try:
        response = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[{"role": "user", "content": prompt}],
            max_tokens=200
        )
        return response.choices[0].message.content.strip()
    except Exception as e:
        print(f"[ERROR] OpenAI generation failed: {e}")
        return f"Check out our new arrival: {product_title}! Shop now: {product_link} #WonderfulGemsPoint #Jewelry"


# -------------------------------------------------------------------
# 4. Social Media Posting Functions
# -------------------------------------------------------------------
def post_to_facebook(page_id, token, caption, image_url):
    if not page_id or not token:
        print("[SKIP] Facebook credentials missing.")
        return
    url = f"https://graph.facebook.com/v19.0/{page_id}/photos"
    payload = {'message': caption, 'url': image_url, 'access_token': token}
    res = requests.post(url, data=payload)
    if res.status_code == 200:
        print(f"[SUCCESS] Posted to Facebook! Photo ID: {res.json().get('id')}")
    else:
        print(f"[ERROR] Facebook Post Failed: {res.text}")


def post_to_instagram(ig_id, token, caption, image_url):
    if not ig_id or not token or not image_url:
        print("[SKIP] Instagram credentials or image URL missing.")
        return
    
    # Step A: Container Creation
    create_url = f"https://graph.facebook.com/v19.0/{ig_id}/media"
    create_payload = {'image_url': image_url, 'caption': caption, 'access_token': token}
    res = requests.post(create_url, data=create_payload)
    if res.status_code != 200:
        print(f"[ERROR] Instagram Container Creation Failed: {res.text}")
        return

    creation_id = res.json().get('id')
    time.sleep(5)  # Pause for processing

    # Step B: Media Publish
    publish_url = f"https://graph.facebook.com/v19.0/{ig_id}/media_publish"
    pub_payload = {'creation_id': creation_id, 'access_token': token}
    pub_res = requests.post(publish_url, data=pub_payload)
    if pub_res.status_code == 200:
        print(f"[SUCCESS] Posted to Instagram! Media ID: {pub_res.json().get('id')}")
    else:
        print(f"[ERROR] Instagram Publishing Failed: {pub_res.text}")


def post_to_tiktok(token, caption, image_url):
    if not token or not image_url:
        print("[SKIP] TikTok token or image missing.")
        return
    url = "https://open.tiktokapis.com/v2/post/publish/content/init/"
    headers = {
        'Authorization': f'Bearer {token}',
        'Content-Type': 'application/json'
    }
    payload = {
        "post_info": {"title": caption, "privacy_level": "PUBLIC_TO_EVERYONE"},
        "source_info": {"source": "PULL_FROM_URL", "photo_cover_index": 1, "photo_images": [image_url]},
        "post_mode": "DIRECT_POST",
        "media_type": "PHOTO"
    }
    res = requests.post(url, json=payload, headers=headers)
    if res.status_code == 200:
        print(f"[SUCCESS] Posted photo to TikTok! Share ID: {res.json().get('data', {}).get('publish_id')}")
    else:
        print(f"[ERROR] TikTok Post Failed: {res.text}")


# -------------------------------------------------------------------
# 5. Main Execution Loop
# -------------------------------------------------------------------
def main():
    print("=== Starting Auto Social Poster Job ===")
    products = fetch_recent_products(RSS_FEED_URL)

    if not products:
        print("[INFO] No new products published in the past 24 hours. Exiting.")
        return

    for item in products:
        caption = generate_post_copy(item['title'], item['link'])
        image_url = item['image_url']

        print(f"\n--- Publishing: {item['title']} ---")
        post_to_facebook(FACEBOOK_PAGE_ID, META_PAGE_ACCESS_TOKEN, caption, image_url)
        post_to_instagram(INSTAGRAM_ACCOUNT_ID, META_PAGE_ACCESS_TOKEN, caption, image_url)
        post_to_tiktok(TIKTOK_ACCESS_TOKEN, caption, image_url)

    print("\n=== Job Completed Successfully ===")


if __name__ == "__main__":
    main()
